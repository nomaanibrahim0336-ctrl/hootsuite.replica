{
  "name": "@hootsuite/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:supabase": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:generate:supabase": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "pretest": "prisma generate --schema prisma/schema.sqlite.prisma && DATABASE_URL=file:/tmp/socialhub-test.db prisma db push --schema prisma/schema.sqlite.prisma --skip-generate --accept-data-loss --force-reset",
    "test": "jest --runInBand --forceExit"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@hootsuite/shared": "*",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "jest": "^30.4.2",
    "prisma": "^5.18.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
