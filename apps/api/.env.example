PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Dev uses SQLite (zero setup). For production, switch the datasource provider
# in prisma/schema.prisma to "postgresql" and use the Postgres URL below.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://hootsuite:secret@localhost:5432/hootsuite"
REDIS_URL=redis://localhost:6379
NODE_ENV=development
