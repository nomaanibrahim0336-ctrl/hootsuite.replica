PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Dev uses SQLite (zero setup).
DATABASE_URL="file:./dev.db"
#
# --- Supabase / Postgres (Phase 9) ---
# To use the provisioned Supabase project instead of SQLite:
#   1. Set DATABASE_URL to your Supabase connection string (get the password
#      from Supabase → Project Settings → Database). Project ref: kvrhkseifkwshnqfvldu
#   2. npm run db:generate:supabase && npm run db:push:supabase && npm run db:seed
#
# Pooled (recommended for serverless):
# DATABASE_URL="postgresql://postgres.kvrhkseifkwshnqfvldu:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.kvrhkseifkwshnqfvldu.supabase.co:5432/postgres"

REDIS_URL=redis://localhost:6379
NODE_ENV=development

# --- LLM providers (Phase 5) ---
# Leave all blank to run on the built-in offline generators (mock).
# Set the active provider here, or switch it at runtime from Settings.
# LLM_PROVIDER=claude        # claude | openai | gemini | deepseek | custom
# LLM_MODEL=                 # optional override of the provider's default model
#
# Add whichever key(s) you have; a provider becomes "configured" once its key exists.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
#
# Custom OpenAI-compatible endpoint:
# CUSTOM_LLM_BASE_URL=https://your-host/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=your-model
