// SocialHub data model.
// Dev uses SQLite for a zero-setup, runnable DB. For production, switch
// `provider` to "postgresql" and point DATABASE_URL at the Postgres in
// docker-compose.yml — the models below are provider-agnostic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  passwordHash        String
  role                String   @default("owner")
  createdAt           DateTime @default(now())
  ayrshareProfileKey  String?

  posts   Post[]
  reports Report[]
}

model Network {
  id             String    @id @default(uuid())
  type           String
  name           String
  username       String
  followers      Int       @default(0)
  connected      Boolean   @default(true)
  connectedAt    DateTime  @default(now())
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  pageId         String?
  pageAccessToken String?
}

model Post {
  id          String    @id @default(uuid())
  content     String
  networks    String // JSON-encoded string[]
  status      String    @default("draft")
  hashtags    String? // JSON-encoded string[]
  scheduledAt DateTime?
  publishedAt DateTime?
  engagements String? // JSON-encoded engagement object
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Approval workflow
  approvalStatus String  @default("none") // none | pending | approved | rejected
  submittedBy    String?
  approvedBy     String?

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  meta      String? // JSON-encoded details
  createdAt DateTime @default(now())
}

model AdvocacyContent {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String   @default("General")
  createdAt DateTime @default(now())

  shares AdvocacyShare[]
}

model AdvocacyShare {
  id            String   @id @default(uuid())
  employeeName  String
  employeeEmail String
  reach         Int      @default(0)
  sharedAt      DateTime @default(now())

  content   AdvocacyContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
}

model Message {
  id         String   @id @default(uuid())
  network    String
  senderName String
  senderUser String
  content    String
  type       String   @default("dm")
  status     String   @default("unread")
  assignedTo String?
  sentiment  String   @default("neutral")
  isRead     Boolean  @default(false)
  notes      String?
  timestamp  DateTime @default(now())

  // Set when this row was synced from a live provider (e.g. Zernio) rather
  // than created locally — externalId is the provider's conversation id,
  // accountId is the provider's connected-account id needed to reply/mark-read.
  externalId String? @unique
  accountId  String?

  replies MessageReply[]
}

model MessageReply {
  id        String   @id @default(uuid())
  content   String
  isFromUs  Boolean  @default(true)
  timestamp DateTime @default(now())

  // Provider message id, set when synced from a live provider — used to
  // dedupe repeated syncs of the same conversation.
  externalId String? @unique

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
}

model SavedReply {
  id      String @id @default(uuid())
  title   String
  content String
}

model Stream {
  id           String   @id @default(uuid())
  name         String
  keywords     String // JSON-encoded string[]
  sources      String // JSON-encoded string[]
  isActive     Boolean  @default(true)
  mentionCount Int      @default(0)
  createdAt    DateTime @default(now())

  mentions Mention[]
}

model Mention {
  id          String   @id @default(uuid())
  network     String
  authorName  String
  authorUser  String
  content     String
  sentiment   String   @default("neutral")
  likes       Int      @default(0)
  shares      Int      @default(0)
  comments    Int      @default(0)
  timestamp   DateTime @default(now())

  // Set when synced from a live provider (e.g. Zernio) — the provider's
  // mention/comment id, used to dedupe across repeated syncs.
  externalId String? @unique

  stream   Stream? @relation(fields: [streamId], references: [id])
  streamId String?
}

model Report {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("custom")
  networks  String // JSON-encoded string[]
  createdAt DateTime @default(now())

  owner   User?   @relation(fields: [ownerId], references: [id])
  ownerId String?
}

model AppSetting {
  key   String @id
  value String
}

// LLM provider API keys entered through the app UI (Settings → AI &
// Automation → Connect). An env var of the same purpose (e.g.
// ANTHROPIC_API_KEY) always takes priority when both are present — this
// table only matters when no env var is set for that provider.
model LlmCredential {
  provider  String   @id // 'claude' | 'openai' | 'gemini' | 'deepseek' | 'custom'
  apiKey    String
  baseUrl   String? // 'custom' provider only
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id       String   @id @default(uuid())
  name     String
  email    String
  role     String   @default("viewer")
  joinedAt DateTime @default(now())
}
